# Copy to .env and fill in. Local runs only; never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pick one LLM provider:
# A) Any OpenAI-compatible service (DeepSeek, DashScope/Qwen, OpenRouter, ...)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# B) Anthropic: LLM_PROVIDER=anthropic and set ANTHROPIC_API_KEY=
# C) GitHub Models (free tier): LLM_PROVIDER=github_models and set GITHUB_TOKEN=

# Optional
# GITHUB_TOKEN=      raises the GitHub search rate limit for local runs
# STATE_SALT=        salt for data/sent.json hashes (defaults to the bot token)
